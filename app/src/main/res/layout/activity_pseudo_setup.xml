<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@color/background">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imageProfile"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_marginBottom="14dp"
        android:scaleType="centerCrop"
        android:background="@drawable/avatar_placeholder"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.BubbleSMS.Circle"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="2dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ajouter une photo"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="28dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenue sur BubbleSMS"
        android:textSize="27sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="8dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Un espace simple et privé pour parler avec tes amis."
        android:textSize="14sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="24dp" />
    <EditText
        android:id="@+id/editPseudo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Ton pseudo"
        android:hintTextColor="#686868"
        android:textColor="@color/text_dark"
        android:inputType="text"
        android:paddingStart="17dp"
        android:paddingEnd="17dp"
        android:background="@drawable/rounded_input_bg"
        android:layout_marginBottom="12dp" />
    <Button
        android:id="@+id/buttonContinue"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Commencer"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:backgroundTint="#F4F4F4"
        android:textColor="#111111" />
</LinearLayout>
