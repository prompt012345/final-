<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#090909">
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/header_bg">
        <ImageButton android:id="@+id/localBack" android:layout_width="42dp" android:layout_height="42dp" android:src="@android:drawable/ic_media_previous" android:tint="#F5F5F5" android:background="@android:color/transparent"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mode local" android:textColor="#F5F5F5" android:textStyle="bold" android:textSize="19sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sans serveur • gratuit" android:textColor="#888888" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
            <TextView android:id="@+id/localStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● Mode local" android:textColor="#F5F5F5" android:textSize="16sp" android:padding="16dp" android:background="@drawable/card_bg"/>
            <TextView android:id="@+id/localIp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wi‑Fi" android:textColor="#AAAAAA" android:textSize="14sp" android:padding="16dp" android:layout_marginTop="12dp"/>
            <Button android:id="@+id/localPick" android:layout_width="match_parent" android:layout_height="54dp" android:text="📎 Choisir image / vidéo / fichier" android:layout_marginTop="20dp"/>
            <Button android:id="@+id/localSend" android:layout_width="match_parent" android:layout_height="54dp" android:text="↗ Envoyer directement en Wi‑Fi" android:layout_marginTop="10dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Le téléphone destinataire doit être sur le même réseau Wi‑Fi et avoir le mode local ouvert. Aucun cloud, aucun serveur." android:textColor="#777777" android:textSize="12sp" android:padding="12dp"/>
            <Button android:id="@+id/localCall" android:layout_width="match_parent" android:layout_height="54dp" android:text="📹 Appel vidéo local" android:layout_marginTop="16dp"/>
            <Button android:id="@+id/localGroupCall" android:layout_width="match_parent" android:layout_height="54dp" android:text="👥 Appel vidéo de groupe" android:layout_marginTop="10dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
