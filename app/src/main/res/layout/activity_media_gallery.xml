<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <TextView android:id="@+id/galleryTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_dark" android:textSize="26sp" android:textStyle="bold"/>
  <TextView android:id="@+id/emptyGallery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aucun média dans cette conversation." android:textColor="@color/text_muted" android:paddingTop="30dp" android:visibility="gone"/>
  <LinearLayout android:id="@+id/galleryList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="18dp"/>
 </LinearLayout>
</ScrollView>
