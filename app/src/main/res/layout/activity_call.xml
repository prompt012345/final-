<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#050505">
    <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical" android:padding="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/callTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Appel vidéo" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:id="@+id/callSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wi‑Fi local • direct" android:textColor="#888888" android:textSize="12sp"/>
        </LinearLayout>
        <ImageButton android:id="@+id/callClose" android:layout_width="44dp" android:layout_height="44dp" android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="#FFFFFF" android:background="@android:color/transparent"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#111111">
        <ImageView android:id="@+id/remoteVideo" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone"/>
        <androidx.camera.view.PreviewView android:id="@+id/localPreview" android:layout_width="120dp" android:layout_height="170dp" android:layout_gravity="top|end" android:layout_margin="14dp" app:scaleType="fillCenter"/>
    </FrameLayout>
    <TextView android:id="@+id/callState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sélectionne un appareil du même Wi‑Fi" android:textColor="#AAAAAA" android:gravity="center" android:padding="10dp"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="120dp"><LinearLayout android:id="@+id/peersList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp"/></ScrollView>
    <Button android:id="@+id/callConnect" android:layout_width="match_parent" android:layout_height="54dp" android:layout_margin="14dp" android:text="Démarrer l'appel"/>
</LinearLayout>
