<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BubbleSMS" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="materialButtonStyle">@style/Widget.BubbleSMS.Button</item>
    </style>

    <style name="Widget.BubbleSMS.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">26dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="ShapeAppearance.BubbleSMS.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
